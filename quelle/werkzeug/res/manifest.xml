<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Als RT_MANIFEST (Typ 24, ID 1) einbetten.  Macht das Bild "normaler";
     NT 4.0 ignoriert es.  In eine .rc:
       1 24 "manifest.xml"
     Nur asInvoker -- keine erhoehten Rechte anfordern. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
